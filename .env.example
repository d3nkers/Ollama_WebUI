# Kopieer naar .env en vul in. .env wordt automatisch geladen (zie app.py),
# maar een reeds gezette shell- of systemd-omgevingsvariabele wint altijd.

# Waar Ollama draait
OLLAMA_HOST=http://localhost:11434

# Default-model als er geen expliciet gekozen is in de UI
OLLAMA_MODEL=llama3.1:8b

# Basic-auth gebruikersnaam
OLLAMA_UI_USER=admin

# Basic-auth wachtwoord — verplicht instellen, gebruik quotes bij speciale tekens.
# Zonder deze variabele genereert de app bij opstart een tijdelijk wachtwoord
# en print dat naar de console (handig om te testen, niet om op te vertrouwen).
OLLAMA_UI_PASS=

# Alleen relevant bij python run.py (HTTPS):
# OLLAMA_UI_HOST=0.0.0.0
# OLLAMA_UI_PORT=8443
# OLLAMA_UI_SSL_HOSTS=gigabyte.local
